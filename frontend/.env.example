# ==============================================================================
# Point of Sale (POS) System - Frontend Environment Variables Template
# ==============================================================================
# Copy this file to ".env" or ".env.local" to configure your frontend.
# Vite automatically exposes variables prefixed with VITE_ to the browser client.
# ==============================================================================

# Backend Spring Boot API Base URL (Default local development: http://localhost:5000)
VITE_API_URL=http://localhost:5000
